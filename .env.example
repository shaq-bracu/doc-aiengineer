# Copy to .env  (docker compose reads it; for local runs `export` the variables or use a tool like direnv)
# NOTE: keep comments on their own lines - docker compose treats "KEY=   # text" as the value "# text".

# Empty => rules-only extraction. Set it to enable the LLM extractor.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# auto | llm | rules
EXTRACTION_MODE=auto
# Set to require an X-API-Key header on every /api call (except /api/health)
API_KEY=
# Documents processed in parallel
WORKERS=2
# Pages OCR'd in parallel inside one document
OCR_THREADS=4
# eng+ben for Bangla (tesseract-ocr-ben is installed in the Docker image)
OCR_LANGS=eng
MAX_UPLOAD_MB=200
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
